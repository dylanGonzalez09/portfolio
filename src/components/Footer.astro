---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ContactBtn from "./ContactBtn.astro";
import LanguajeSelector from "./LanguajeSelector.astro";
import Github from "./social/Github.astro";
import Instagram from "./social/Instagram.astro";
import LinkedIn from "./social/LinkedIn.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="h-96 bg-slate-900/45 w-full md:pl-8">
  <h3
    class="text-xl md:text-2xl mt-16 px-4 md:px-0 text-center md:text-start text-white"
  >
    {t("footer.title")} 🚀
  </h3>

  <div class="w-full flex justify-center items-center md:justify-start">
    <ContactBtn
      title={t("footer.contact")}
      classes="mt-8 flex justify-center items-center"
    />
  </div>

  <div class="w-full flex flex-col mt-8">
    <h3 class="text-xl font-sans text-center md:text-start text-white">
      {t("footer.social")}
    </h3>
    <div
      class="w-full flex items-center justify-center md:justify-start gap-4 mt-10"
    >
      <LinkedIn classes="w-10 h-10" />
      <Instagram classes="w-10 h-10" />
      <Github classes="w-10 h-10" />
    </div>
  </div>
</div>
