---
import Logo from "./Logo.astro";

import { getLangFromUrl, useTranslations } from "../i18n/utils";
import LanguajeSelector from "./LanguajeSelector.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav
  class="bg-slate-900/45 backdrop-blur-md p-3 rounded-xl md:rounded-full fixed left-1/2 transform -translate-x-1/2 text-white z-50 flex flex-col md:flex-row justify-center items-center mt-8 gap-2"
>
  <Logo />

  <ul
    class="md:mr-2 flex flex-row justify-center items-center gap-2 md:gap-10 text-center"
  >
    <li class="transform transition duration-300 hover:scale-110 w-full">
      <a href="#experience" class="md:text-xl">{t("nav.experience")}</a>
    </li>
    <li class="transform transition duration-300 hover:scale-110 w-full">
      <a href="#projects" class="md:text-xl">{t("nav.projects")}</a>
    </li>
    <li class="transform transition duration-300 hover:scale-110 w-full">
      <a href="#stack" class="md:text-xl">{t("nav.stack")}</a>
    </li>
    <li class="transform transition duration-300 hover:scale-110 w-full">
      <a href="#contact" class="md:text-xl">{t("nav.contact")}</a>
    </li>
  </ul>

  <LanguajeSelector />
</nav>
